msgid "Author Chat"
msgstr "Author Chat"

#. Plugin URI of the plugin
#: acppauthorchat-author-chat.php
msgid "https://github.com/Pantsoffski/Author-Chat-Plugin"
msgstr "https://github.com/Pantsoffski/Author-Chat-Plugin"

#. Description of the plugin
#: acppauthorchat-author-chat.php
msgid "Plugin that gives your authors an easy way to communicate through back-end UI (admin panel)."
msgstr "Este plugin permite a los autores de tu sitio comunicarse desde el escritorio de WordPress."

#. Author of the plugin
#: acppauthorchat-author-chat.php
msgid "Piotr Pesta"
msgstr "Piotr Pesta"

#. Author URI of the plugin
#: acppauthorchat-author-chat.php
msgid "https://github.com/Pantsoffski"
msgstr "https://github.com/Pantsoffski"

#: acppauthorchat-author-chat.php:142
msgid "Today"
msgstr "Hoy"

#: acppauthorchat-author-chat.php:143
msgid "Yesterday"
msgstr "Ayer"

#: acppauthorchat-author-chat.php:144
msgid "Sunday"
msgstr "Domingo"

#: acppauthorchat-author-chat.php:145
msgid "Monday"
msgstr "Lunes"

#: acppauthorchat-author-chat.php:146
msgid "Tuesday"
msgstr "Martes"

#: acppauthorchat-author-chat.php:147
msgid "Wednesday"
msgstr "Miércoles"

#: acppauthorchat-author-chat.php:148
msgid "Thursday"
msgstr "Jueves"

#: acppauthorchat-author-chat.php:149
msgid "Friday"
msgstr "Viernes"

#: acppauthorchat-author-chat.php:150
msgid "Saturday"
msgstr "Sábado"

#: acppauthorchat-author-chat.php:164
msgid "Author Chat Options"
msgstr "Opciones de Author Chat"

#: acppauthorchat-author-chat.php:202
msgid "Settings"
msgstr "Ajustes"

#: acppauthorchat-author-chat.php:212
msgid "Chat rooms"
msgstr "Salas de chat"

#: acppauthorchat-author-chat.php:213
msgid "Room participants"
msgstr "Participantes de la sala"

#: acppauthorchat-author-chat.php:214
msgid "Messages"
msgstr "Mensajes"

#: acppauthorchat-author-chat.php:216
msgid "Your message"
msgstr "Tu mensaje"

#: acppauthorchat-author-chat.php:217
msgid "Your message..."
msgstr "Tu mensaje..."

#: acppauthorchat-author-chat.php:237
msgid "Automatic chat cleanup is disabled."
msgstr "La limpieza automática del historial del chat está desactivada."

#: acppauthorchat-author-chat.php:242
msgid "Chat deletion is disabled."
msgstr "La eliminación del chat está desactivada."

#: acppauthorchat-options.php:7
msgid "All users belonging to this site"
msgstr "Todos los usuarios de este sitio"

#: acppauthorchat-options.php:8
msgid "Editors"
msgstr "Editores"

#: acppauthorchat-options.php:9
msgid "Authors"
msgstr "Autores"

#: acppauthorchat-options.php:10
msgid "Contributors"
msgstr "Colaboradores"

#: acppauthorchat-options.php:11
msgid "Subscribers"
msgstr "Suscriptores"

#: acppauthorchat-options.php:12
msgid "Use display names instead of login names"
msgstr "Usar los nombres visibles en vez de los nombres de usuario"

#: acppauthorchat-options.php:13
msgid "Show the floating chat on other admin pages"
msgstr "Mostrar el chat flotante en otras pantallas de administración"

#: acppauthorchat-options.php:14
msgid "Show my name on my messages"
msgstr "Mostrar mi nombre junto a mis mensajes"

#: acppauthorchat-options.php:15
msgid "Show weekday names for recent messages"
msgstr "Mostrar el día de la semana en los mensajes recientes"

#: acppauthorchat-options.php:19
msgid "Author Chat settings"
msgstr "Ajustes de Author Chat"

#. translators: %d: number of messages removed by this request.
#: acppauthorchat-options.php:26
#, php-format
msgid "Removed %d old message."
msgid_plural "Removed %d old messages."
msgstr[0] "Se ha eliminado %d mensaje antiguo."
msgstr[1] "Se han eliminado %d mensajes antiguos."

#: acppauthorchat-options.php:30
msgid "Private rooms require membership. Only the room owner can manage participants."
msgstr "Solo los miembros pueden acceder a las salas privadas. Solo el propietario de la sala puede gestionar a los participantes."

#: acppauthorchat-options.php:41
msgid "Refresh interval (seconds)"
msgstr "Intervalo de actualización (segundos)"

#: acppauthorchat-options.php:43
msgid "Age threshold for manual cleanup (days)"
msgstr "Antigüedad mínima de los mensajes para la limpieza manual (días)"

#: acppauthorchat-options.php:45
msgid "Saving this value does not delete messages. There is no automatic retention job."
msgstr "Guardar este valor no elimina mensajes. La limpieza del historial no se ejecuta automáticamente."

#: acppauthorchat-options.php:49
msgid "Manual history cleanup"
msgstr "Limpieza manual del historial"

#: acppauthorchat-options.php:50
msgid "Each confirmed request permanently removes at most 500 messages older than the saved threshold, across all rooms on this site. Memberships and room IDs are retained. Back up the database first."
msgstr "Cada limpieza confirmada elimina de forma permanente hasta 500 mensajes que superen la antigüedad indicada, en todas las salas de este sitio. Se conservan los miembros y los identificadores de las salas. Antes de continuar, haz una copia de seguridad de la base de datos."

#: acppauthorchat-options.php:54
msgid "I understand that these messages cannot be restored by the plugin."
msgstr "Entiendo que el plugin no puede recuperar estos mensajes."

#: acppauthorchat-options.php:55
msgid "Remove up to 500 old messages"
msgstr "Eliminar hasta 500 mensajes antiguos"

#: acppauthorchat-options.php:57
msgid "External previews and push notifications are not used. Older preview, deletion and license options are retained in storage but are not active settings."
msgstr "No se usan vistas previas externas ni notificaciones push. Los ajustes antiguos de vistas previas, eliminación y licencias siguen guardados, pero están inactivos."

#: acppauthorchat-options.php:74
#: acppauthorchat-process.php:11
msgid "Access denied."
msgstr "Acceso denegado."

#: acppauthorchat-options.php:77
msgid "Explicit confirmation is required."
msgstr "Debes confirmar la operación de forma explícita."

#: acppauthorchat-process.php:15
msgid "Chat is temporarily unavailable."
msgstr "El chat no está disponible temporalmente."

#: acppauthorchat-process.php:19
msgid "Invalid chat request."
msgstr "La solicitud del chat no es válida."

#: acppauthorchat-process.php:23
msgid "Private chat is unavailable. Please contact the site administrator."
msgstr "El chat privado no está disponible. Ponte en contacto con la persona responsable de administrar el sitio."

#: acppauthorchat-process.php:56
msgid "Author Chat database upgrade is incomplete. Existing data has been retained. Please contact the site administrator."
msgstr "La actualización de la base de datos de Author Chat no ha finalizado. Se han conservado los datos existentes. Ponte en contacto con la persona responsable de administrar el sitio."

#: acppauthorchat-process.php:61
msgid "Author Chat: the participants table is missing or incomplete. Database upgrade has not completed. Only the main room is available."
msgstr "Author Chat: falta la tabla de participantes o está incompleta. La actualización de la base de datos no ha finalizado. Solo está disponible la sala principal."

#: acppauthorchat-process.php:159
msgid "Chat writes are unavailable with the current database configuration. Please contact the site administrator."
msgstr "La configuración actual de la base de datos impide guardar datos del chat. Ponte en contacto con la persona responsable de administrar el sitio."

#: acppauthorchat-process.php:323
msgid "Please sign in again."
msgstr "Vuelve a iniciar sesión."

#: acppauthorchat-process.php:325
msgid "Chat access is disabled for this user."
msgstr "Este usuario no tiene acceso al chat."

#: acppauthorchat-process.php:327
msgid "Please reload the page before using chat."
msgstr "Recarga la página antes de usar el chat."

#: acppauthorchat-schema.php:6
msgid "Author Chat database upgrade is incomplete. Please contact the site administrator."
msgstr "La actualización de la base de datos de Author Chat no ha finalizado. Ponte en contacto con la persona responsable de administrar el sitio."

#: uninstall.php:18
msgid "Author Chat data removal failed. Check database permissions and retry deleting the plugin."
msgstr "No se han podido eliminar todos los datos de Author Chat. Comprueba los permisos de la base de datos e intenta eliminar el plugin de nuevo."

#: acppauthorchat_chat.js:275
msgid "Chat unavailable. Please try again."
msgstr "El chat no está disponible. Inténtalo de nuevo."

#: acppauthorchat_chat.js:280
msgid "Please sign in again or reload the page. Your unsent text is kept below."
msgstr "Vuelve a iniciar sesión o recarga la página. Encontrarás abajo el texto que no se ha enviado."

#: acppauthorchat_chat.js:284
msgid "This room is no longer available. Your unsent text has been kept."
msgstr "Esta sala ya no está disponible. Se ha conservado el texto que no se ha enviado."

#. translators: %s: Error message explaining why the request failed.
#: acppauthorchat_chat.js:287
#, js-format
msgid "%s Your unsent text has been kept."
msgstr "%s Se ha conservado el texto que no se ha enviado."

#: acppauthorchat_chat.js:385
msgid "Invalid chat response. Please reload."
msgstr "La respuesta del chat no es válida. Recarga la página."

#: acppauthorchat_chat.js:396
msgid "Invalid history cursor. Please reload."
msgstr "La posición en el historial no es válida. Recarga la página."

#. translators: %d: Number of unread chat messages.
#: acppauthorchat_chat.js:434
#, js-format
msgid "%d unread message"
msgid_plural "%d unread messages"
msgstr[0] "%d mensaje sin leer"
msgstr[1] "%d mensajes sin leer"

#. translators: 1: Number of unread chat messages. 2: Original page title.
#: acppauthorchat_chat.js:437
#, js-format
msgid "(%1$d) %2$s"
msgstr "(%1$d) %2$s"

#: acppauthorchat_chat.js:490
msgid "Main room"
msgstr "Sala principal"

#. translators: %s: Private room number.
#: acppauthorchat_chat.js:492
#, js-format
msgid "Room %s"
msgstr "Sala %s"

#: acppauthorchat_chat.js:501
msgid "Delivery unconfirmed. Check history before retrying."
msgstr "La entrega no se ha confirmado. Revisa el historial antes de volver a enviar el mensaje."

#: acppauthorchat_chat.js:502
msgid "Sending..."
msgstr "Enviando…"

#: acppauthorchat_chat.js:502
msgid "Queued"
msgstr "En cola"

#. translators: 1: Room name. 2: Message delivery status.
#: acppauthorchat_chat.js:504
#, js-format
msgid "%1$s: %2$s"
msgstr "%1$s: %2$s"

#: acppauthorchat_chat.js:507
msgid "Retry"
msgstr "Reintentar"

#: acppauthorchat_chat.js:512
msgid "Move to draft"
msgstr "Pasar a borrador"

#. translators: %s: Room name.
#: acppauthorchat_chat.js:530
#, js-format
msgid "Unsent draft (%s)"
msgstr "Borrador sin enviar (%s)"

#: acppauthorchat_chat.js:728
msgid "Secure request IDs are unavailable. Please use a current browser."
msgstr "No se pueden generar identificadores seguros para las solicitudes. Usa un navegador actualizado."

#: acppauthorchat_chat.js:764
msgid "Add room"
msgstr "Añadir sala"

#: acppauthorchat_chat.js:770
msgid "Private chat is unavailable. The main room is still available."
msgstr "El chat privado no está disponible. Puedes seguir usando la sala principal."

#: acppauthorchat_chat.js:795
msgid "Add participant"
msgstr "Añadir participante"

#: acppauthorchat_chat.js:795
#: acppauthorchat_chat.js:849
msgid "Type a nickname..."
msgstr "Escribe un alias…"

#: acppauthorchat_chat.js:799
msgid "No matching participants."
msgstr "No hay participantes que coincidan con la búsqueda."

#. translators: %d: Number of matching participants in the autocomplete list.
#: acppauthorchat_chat.js:802
#, js-format
msgid "%d matching participant. Use the up and down arrow keys to navigate."
msgid_plural "%d matching participants. Use the up and down arrow keys to navigate."
msgstr[0] "%d participante coincide con la búsqueda. Usa las flechas arriba y abajo para recorrer los resultados."
msgstr[1] "%d participantes coinciden con la búsqueda. Usa las flechas arriba y abajo para recorrer los resultados."

#. translators: %s: Participant's display name or username.
#: acppauthorchat_chat.js:908
#, js-format
msgid "Remove participant: %s"
msgstr "Quitar participante: %s"

#: acppauthorchat_chat.js:915
msgid "Only the room owner can remove participants."
msgstr "Solo el propietario de la sala puede quitar participantes."
