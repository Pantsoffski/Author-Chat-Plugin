{
  "name": "author-chat-local-tests",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "lint:php": "node tests/lint-php.cjs",
    "test:php": "php tests/security-php.php",
    "env:start": "wp-env start",
    "env:start:multisite": "wp-env start --config=.wp-env.multisite.json",
    "test:integration": "wp-env run tests-cli wp eval-file wp-content/plugins/author-chat/tests/integration.php",
    "build:release": "node tests/build-release.cjs",
    "test:lifecycle:single": "node tests/lifecycle.cjs wp-env-authorchat-release-dd961dd4-tests-cli-1",
    "test:lifecycle:multisite": "node tests/lifecycle.cjs wp-env-authorchat-releasemultisite-f63cd781-tests-cli-1"
  },
  "devDependencies": {
    "@wordpress/env": "^12.1.0",
    "adm-zip": "0.6.1"
  },
  "overrides": {
    "@wp-playground/cli@3.1.64": {
      "express": "4.22.3"
    },
    "@wp-playground/storage@3.1.64": {
      "isomorphic-git": "1.38.6"
    }
  }
}
